object Animal
object Perro extends Animal
object Gato extends Animal

object Lista[+A](val elemento: A)

method main {
  val listaDePerros: Lista[Perro] = new Lista(new Perro);

  val listaDeAnimales: Lista[Animal] = listaDePerros;

  print("Imprime la linea de animales perros: ${listaDeAnimales.elemento}")
}
